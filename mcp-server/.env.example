# 东方财富妙想 API Key（必填）
MX_APIKEY=your_mx_apikey_here

# Tushare Pro Token（选填，补充财务数据）
TUSHARE_TOKEN=your_tushare_token_here

# Anthropic API Key（分析报告类 Tool 需要）
ANTHROPIC_API_KEY=your_api_key_here

# 自定义 API 端点（使用 DeepSeek 代理时填写）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 报告生成模型（默认 claude-sonnet-4-6）
ANTHROPIC_MODEL=deepseek-v4-pro[1m]

# 报告下载链接的基础 URL（内网/ngrok/cloudflared）
REPORT_BASE_URL=http://127.0.0.1:8000
